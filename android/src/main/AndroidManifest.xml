<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
 <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
 <!-- Android 13+: the foreground notification (with its Disconnect action) is hidden without this runtime permission -->
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".VpnForegroundService"
            android:exported="false" 
            android:foregroundServiceType="connectedDevice" />
        <!-- Kill switch: blocking VPN session while the tunnel is down (KillSwitchVpnService.kt). The system binds it
             with BIND_VPN_SERVICE; same foreground type as VpnForegroundService. -->
        <service
            android:name=".KillSwitchVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="connectedDevice">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <!-- Notification "Disconnect" / "Turn off kill switch" actions; explicit PendingIntent only, never exported -->
        <receiver
            android:name=".VpnDisconnectReceiver"
            android:exported="false" />
    </application>
</manifest>
